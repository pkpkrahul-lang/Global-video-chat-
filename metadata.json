{
  "name": "Video Chat with Coins",
  "version": "1.0.0",
  "description": "A web-based random video chat with real-time WebRTC audio/video, text chat, matchmaking, and a coin-based premium economy for tipping, virtual gifts, and premium match options. Designed for low-latency peer connections with optional TURN support and session management.",
  "requestFramePermissions": ["camera", "microphone"],
  "majorCapabilities": ["MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API"],
