    }
  ],
  "license": "MIT",
  "homepage": "https://example.com",
  "supportUrl": "https://github.com/pkpkrahul-lang/Global-video-chat-/issues",
  "contactEmail": "support@example.com",
  "termsOfServiceUrl": "https://example.com/terms",
  "privacyPolicyUrl": "https://example.com/privacy",
  "defaultLocale": "en",
  "locales": ["en", "hi"],
  "keywords": ["video", "webrtc", "chat", "matchmaking", "realtime", "coins", "streaming", "social"],
  "categories": ["communication", "social"],
  "icons": {
    "32": "icons/icon-32.png",
    "128": "icons/icon-128.png"
  },
  "screenshots": [
    "screenshots/room-1.png",
    "screenshots/chat-1.png"
  ],
  "contentRating": "Teen",
  "permissions": {
    "usesCamera": true,
    "usesMicrophone": true,
    "storesPersonalData": ["audio", "video", "displayName", "email (optional)"]
  },
  "dataUsage": {
    "storage": "Ephemeral by default; optional recordings stored in configured object storage (S3/GCS) with consent",
    "thirdParties": ["TURN provider (if configured)", "Analytics/Sentry (optional)", "Gemini AI (server-side)"]
  },
  "features": {
    "matchmaking": true,
    "coinsEconomy": true,
    "recordingOptional": false,
    "screenShare": true,
    "textChat": true
  },
  "notes": "Replace example URLs and contact emails with real values. Ensure privacyPolicyUrl and termsOfServiceUrl are set before publishing. Use secret manager for runtime credentials."
}
