# Global Video Chat — Example environment variables
# DO NOT commit real secrets. Replace placeholders before deploying.
# Use a secret manager (GCP Secret Manager / GitHub Secrets) for production.

# APP
NODE_ENV=development           # development|staging|production
PORT=8080                      # runtime port (Cloud Run may override)
APP_URL="https://example.com"  # public URL (include https://). Used for callbacks and links.

# AI / Gemini
# Provide read-only API key with the minimum required scopes.
GEMINI_API_KEY="CHANGE_ME_GEMINI_API_KEY"

# AUTH / SESSION / TOKENS
# Use long, high-entropy strings for secrets (32+ chars). Rotate regularly.
JWT_SECRET="CHANGE_ME_RANDOM_LONG_SECRET"       # used to sign JWTs (if applicable)
SESSION_SECRET="CHANGE_ME_SESSION_SECRET"       # for server sessions/cookies
ACCESS_TOKEN_TTL=900                             # seconds (e.g. 15m)
REFRESH_TOKEN_TTL=2592000                        # seconds (e.g. 30d)

# DATABASE / CACHE (if applicable)
DATABASE_URL="postgres://user:pass@host:5432/dbname"   # example, or leave blank if unused
REDIS_URL="redis://:password@host:6379/0"              # optional, for presence/locks

# TURN / STUN (recommended for reliable NAT traversal)
# Provide TURN credentials or a URL to your TURN server. If using a TURN service,
# consider ephemeral credentials (time-limited).
TURN_URL="turn:turn.example.com:3478"
TURN_USERNAME="CHANGE_ME_TURN_USER"
TURN_PASSWORD="CHANGE_ME_TURN_PASS"

# CORS / ORIGINS
# Comma-separated list of allowed origins for browser requests
CORS_ALLOWED_ORIGINS="https://example.com,https://staging.example.com"

# SECURITY / COOKIES
COOKIE_SECURE=true               # true in production (send cookies only over HTTPS)
COOKIE_SAMESITE=Lax              # Lax | Strict | None

# LOGGING / MONITORING / SENTRY
LOG_LEVEL=info                   # debug|info|warn|error
SENTRY_DSN=""                    # optional: set in production

# OPTIONAL: OAuth providers (if used)
# For example Google OAuth (use secret manager for the client secret)
OAUTH_GOOGLE_CLIENT_ID=""
OAUTH_GOOGLE_CLIENT_SECRET=""

# TRUST / PROXY
TRUST_PROXY=true                 # set true if behind a proxy/load-balancer (Cloud Run)

# Feature flags / runtime toggles
ENABLE_RECORDING=false
ENABLE_SCREENSHARE=true

# Notes:
# - Keep this file as documentation only. Do NOT store real credentials here.
# - Use a library to validate required env vars at startup (dotenv-safe / envalid / joi).
# - For Cloud Run: inject secrets from Secret Manager; avoid exposing secret values in logs.
